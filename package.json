{
  "name": "freekicks",
  "version": "0.1.0",
  "private": true,
  "description": "Free-kick arcade game (Magical Kicks style) for Android, built with Three.js + Capacitor",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "export-assets": "node tools/export-assets.cjs",
    "playtest": "node tools/playtest.cjs",
    "android:sync": "npm run build && npx cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "7.4.3",
    "@capacitor/core": "7.4.3",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@capacitor/cli": "7.4.3",
    "@types/node": "22.15.30",
    "@types/three": "0.180.0",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.2.4"
  }
}
